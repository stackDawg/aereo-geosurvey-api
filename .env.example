# Copy to .env to override the defaults. Every setting uses the GEOAPI_ prefix.
GEOAPI_DATABASE_URL=sqlite:///./data/geoapi.db
# GEOAPI_DATABASE_URL=postgresql+psycopg://geo:geo@localhost:5432/geo
GEOAPI_STORAGE_DIR=./data/uploads

# Set to process uploads in RQ workers (`rq worker --url $GEOAPI_REDIS_URL geo-processing`).
# GEOAPI_REDIS_URL=redis://localhost:6379/0
GEOAPI_QUEUE_NAME=geo-processing

# Allow POST /api/auth/keys/ without credentials (otherwise: python -m app.cli create-key NAME)
GEOAPI_ALLOW_KEY_SIGNUP=true

GEOAPI_MAX_UPLOAD_SIZE_MB=100
GEOAPI_MAX_EXTRACTED_SIZE_MB=500
GEOAPI_MAX_ARCHIVE_MEMBERS=1000
# utm (default) or laea - see "CRS handling" in the README
GEOAPI_MEASUREMENT_CRS_STRATEGY=utm
GEOAPI_FRONTEND_DIR=./frontend/dist
GEOAPI_LOG_LEVEL=INFO
